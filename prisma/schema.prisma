datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  role           String   @default("EMITTER") // "EMITTER", "UTILIZER", "RESEARCHER", "ADMIN"
  organizationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization        Organization?    @relation(fields: [organizationId], references: [id])
  carbonSources       CarbonSource[]
  contactRequestsSent ContactRequest[] @relation("RequestsSent")
  contactRequestsRecv ContactRequest[] @relation("RequestsReceived")
  savedMatches        SavedMatch[]
  notifications       Notification[]
  demoRequests        DemoRequest[]
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  type      String   // "Industrial Emitter", "Chemical Manufacturer", "Research Institute", "CleanTech Venture"
  location  String
  website   String?
  verified  Boolean  @default(true)
  createdAt DateTime @default(now())

  users         User[]
  carbonSources CarbonSource[]
  products      Product[]
  documents     Document[]
  suppliers     Supplier[]
  reports       Report[]
  demoRequests  DemoRequest[]
}

model CarbonSource {
  id                    String   @id @default(cuid())
  title                 String
  emitterId             String
  organizationId        String
  location              String
  quantityValue         Float
  quantityUnit          String   // "tonnes/month", "tonnes/year", "tonnes/day", "kg/day"
  annualQuantityTonnes  Float
  purityPercent         Float
  physicalState         String   // "Gas", "Liquid", "Supercritical", "Solid"
  temperatureC          Float
  pressureBar           Float
  captureTechnology     String
  availabilityFrequency String   // "Continuous 24/7", "Batch Daily", "Intermittent", "Seasonal"
  transportRadiusKm     Float    @default(200.0)
  impuritiesNotes       String?
  certificationStatus   String   @default("Verified Third-Party")
  status                String   @default("ACTIVE") // "ACTIVE", "MATCHED", "INACTIVE"
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  emitter      User         @relation(fields: [emitterId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  matches      Match[]
}

model Product {
  id                       String   @id @default(cuid())
  name                     String
  slug                     String   @unique
  category                 String   // "E-Fuels", "Building Materials", "Chemicals", "Biomass & Agriculture", "Polymers"
  description              String
  minCO2Purity             Float
  maxCO2Purity             Float    @default(100.0)
  minQuantityTonnesMonth   Float
  maxQuantityTonnesMonth   Float
  requiredState            String   // "Gas", "Liquid", "Supercritical", "Any"
  temperatureMin           Float
  temperatureMax           Float
  pressureMin              Float
  pressureMax              Float
  technologyReadinessLevel Int      // 1 to 9
  locationRequirements     String
  energyIntensity          String   // "High", "Moderate", "Low"
  estimatedValuePerTon     Float
  co2UtilizationPotential  String   // e.g. "1.37 t CO2 / t product"
  organizationId           String?
  active                   Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  matches      Match[]
}

model Match {
  id                 String   @id @default(cuid())
  carbonSourceId     String
  productId          String
  overallScore       Float
  classification     String   // "EXCELLENT", "STRONG", "POTENTIAL", "WEAK", "POOR"
  purityScore        Float
  quantityScore      Float
  stateScore         Float
  tempScore          Float
  pressureScore      Float
  locationScore      Float
  trlScore           Float
  availabilityScore  Float
  greenReasonsJson   String   // JSON string
  concernsJson       String   // JSON string
  recommendationText String
  createdAt          DateTime @default(now())

  carbonSource    CarbonSource     @relation(fields: [carbonSourceId], references: [id], onDelete: Cascade)
  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  savedMatches    SavedMatch[]
  contactRequests ContactRequest[]
}

model SavedMatch {
  id        String   @id @default(cuid())
  userId    String
  matchId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
}

model ContactRequest {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  matchId    String
  message    String
  status     String   @default("PENDING") // "PENDING", "ACCEPTED", "REJECTED", "CONTACTED"
  createdAt  DateTime @default(now())

  sender   User  @relation("RequestsSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User  @relation("RequestsReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  match    Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Document {
  id              String   @id @default(cuid())
  organizationId  String
  uploadedBy      String
  filename        String
  fileType        String
  fileSize        Int
  storagePath     String
  status          String   @default("UPLOADED") // UPLOADED, QUEUED, PROCESSING, EXTRACTED, MATCHING, COMPLETED, FAILED, REVIEW_REQUIRED
  documentType    String   @default("INVOICE") // INVOICE, QUOTATION, BOM, ENERGY_BILL, STREAM_REPORT
  supplierName    String?
  invoiceNumber   String?
  issueDate       DateTime?
  currency        String   @default("USD")
  totalCO2eKg     Float    @default(0.0)
  confidenceAvg   Float    @default(0.0)
  processingError String?
  uploadedAt      DateTime @default(now())
  processedAt     DateTime?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lineItems    DocumentLineItem[]
}

model DocumentLineItem {
  id                     String   @id @default(cuid())
  documentId             String
  description            String
  quantity               Float
  unit                   String
  unitPrice              Float    @default(0.0)
  category               String   @default("General Raw Material")
  supplier               String?
  country                String   @default("Global")
  matchedEmissionFactorId String?
  co2eKg                 Float    @default(0.0)
  confidence             Float    @default(0.0)
  status                 String   @default("MATCHED")

  document       Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  emissionFactor EmissionFactor? @relation(fields: [matchedEmissionFactorId], references: [id])
}

model EmissionFactor {
  id             String   @id @default(cuid())
  name           String
  category       String
  subcategory    String?
  factorValue    Float    // kg CO2e / unit
  unit           String   // e.g. "kg", "kWh", "litre"
  geography      String   @default("Global")
  sourceDatabase String   @default("GHG Protocol / ecoinvent 3.10")
  version        String   @default("2026.1")
  qualityGrade   String   @default("Verified A-Grade")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  lineItems DocumentLineItem[]
}

model UtilizationPathway {
  id                   String   @id @default(cuid())
  name                 String
  category             String   // E-METHANOL, E-FUELS, CONCRETE_MINERALIZATION, SYNTHETIC_FUELS, CHEMICAL_FEEDSTOCK
  requiredPurity       Float
  minVolume            Float
  maxVolume            Float
  requiredPressure     Float
  requiredState        String   @default("Gas")
  geography            String   @default("Global")
  conversionEfficiency Float    @default(0.92)
  estimatedValuePerTon Float    @default(150.0)
  status               String   @default("ACTIVE")
  createdAt            DateTime @default(now())
}

model Supplier {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  country        String
  category       String
  co2eScoreAvg   Float    @default(0.0)
  status         String   @default("VERIFIED")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Report {
  id              String   @id @default(cuid())
  organizationId  String
  title           String
  type            String   // "SUMMARY", "SCOPE_1", "SCOPE_2", "SCOPE_3", "CBAM", "SOURCE_MATCHING"
  format          String   @default("PDF") // PDF, CSV, JSON
  downloadUrl     String
  totalCO2eTonnes Float    @default(0.0)
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String   // LOGIN, REGISTER, DOCUMENT_UPLOAD, DOCUMENT_PROCESS, MATCH_CREATED, ADMIN_ACTION
  resource  String
  ipAddress String?
  details   String?
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model DemoRequest {
  id             String    @id @default(cuid())
  readableId     String?   @unique
  userId         String?
  organizationId String?
  fullName       String
  workEmail      String
  phone          String?
  companyName    String
  jobTitle       String?
  companySize    String?
  industry       String?
  country        String?   @default("India")
  state          String?
  city           String?
  pincode        String?
  gstin          String?
  timezone       String?   @default("Asia/Kolkata")
  role           String    @default("EMITTER")
  message        String?
  preferredDate  String?
  preferredTime  String?
  status         String    @default("PENDING") // PENDING, CONTACTED, SCHEDULED, COMPLETED, CANCELLED, REJECTED
  source         String    @default("WEBSITE")
  notes          String?
  contactedAt    DateTime?
  scheduledAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([workEmail])
  @@index([status])
}

